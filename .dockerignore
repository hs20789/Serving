# Version control
.git/
.gitignore

# Local Python environments and generated bytecode
.venv/
venv/
env/
**/__pycache__/
**/*.py[cod]

# Test, coverage, lint, and type-check caches
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# IDE and OS metadata
.idea/
.vscode/
.claude/
*.iml
*.swp
*.swo
.DS_Store

# Local configuration and build outputs
.env
.env.*
build/
dist/
*.egg-info/

# Runtime image에 필요하지 않은 개발 자료
tests/
scripts/
README.md

# 실험용 가중치는 제외하고 서빙할 모델 하나만 build context에 포함한다.
models/*
!models/model.pth
